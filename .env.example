# ==============================================================================
# GitHub Profile SVG Generator Bot - Environment Configuration
# ==============================================================================

# GitHub Personal Access Token (PAT)
# Optional for basic public stats, but strongly recommended to elevate API rate limit
# from 60 to 5,000 requests/hour and enable detailed commit search metrics.
# Format: ghp_xxxxxxxxxxxxxxxxxxxx or github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# Target GitHub Username to monitor
GITHUB_USERNAME=arif-z04

# Update frequency in hours (e.g. 1 for hourly updates)
UPDATE_INTERVAL_HOURS=1

# Remote git branch to push updated SVGs to
GIT_BRANCH=main

# Repository Root Directory (Optional: leave empty to auto-detect current directory)
REPO_DIR=
